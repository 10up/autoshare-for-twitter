{
	"name": "@10up/autoshare-for-twitter",
	"version": "2.3.4",
	"description": "Automatically shares a post title, URL, and optional description to X/Twitter.",
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"lint:js": "wp-scripts lint-js",
		"lint:js-fix": "wp-scripts lint-js --fix",
		"wp-env": "wp-env",
		"wp-env:test": "wp-env --config=.wp-env.test.json",
		"test:php": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/autoshare-for-twitter vendor/bin/phpunit -c phpunit.xml.dist",
		"test:php:multisite": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/autoshare-for-twitter env WP_MULTISITE=1 vendor/bin/phpunit -c phpunit.xml.dist",
		"test:e2e": "wp-scripts test-playwright --wp-env-config=.wp-env.test.json --config tests/e2e/playwright.config.ts",
		"test:e2e:debug": "wp-scripts test-playwright --wp-env-config=.wp-env.test.json --config tests/e2e/playwright.config.ts --ui"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.js": [
			"wp-scripts lint-js"
		],
		"*.php": [
			"./vendor/bin/phpcs --extensions=php --warning-severity=8 -s"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/10up/autoshare.git"
	},
	"author": "10up",
	"bugs": {
		"url": "https://github.com/10up/autoshare/issues"
	},
	"homepage": "https://github.com/10up/autoshare#readme",
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@wordpress/e2e-test-utils-playwright": "3.3.0",
		"@wordpress/env": "12.2.0",
		"@wordpress/scripts": "37.2.0",
		"husky": "^3.0.5",
		"lint-staged": "^9.2.5",
		"node-wp-i18n": "^1.2.3"
	}
}
